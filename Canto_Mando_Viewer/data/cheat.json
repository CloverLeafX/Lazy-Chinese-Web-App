  "watchout": [
    { "error": "唔 negates verbs/adj, NOT nouns",       "wrong": "我唔錢",     "correct": "我没有钱 (use 冇/没有)" },
    { "error": "喺…度 BOTH parts must convert",          "wrong": "在袋度",     "correct": "在袋子里 (度→里)" },
    { "error": "哋 (plural) vs 哋 (adverbial 地)",        "wrong": "我们慢慢们走", "correct": "我们慢慢地走" },
